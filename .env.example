# =============================================================================
# PostgreSQL Database Connection URL & Security Details (Template)
# Set or replace DATABASE_URL whenever required for your deployment
# =============================================================================
DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/learning_assistant_db
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_postgres_password_here
PG_DATABASE=learning_assistant_db

# =============================================================================
# Application Cryptographic Keys & JWT Security
# =============================================================================
SECRET_KEY=generate_a_random_flask_secret_key_here
JWT_SECRET_KEY=generate_a_random_jwt_secret_key_here

# =============================================================================
# Mail Service Credentials (for Password Reset)
# =============================================================================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_email_app_password
